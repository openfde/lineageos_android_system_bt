diff --git a/hci/src/hci_layer.cc b/hci/src/hci_layer.cc
index 976d91d56..37cfb90cb 100644
--- a/hci/src/hci_layer.cc
+++ b/hci/src/hci_layer.cc
@@ -19,6 +19,8 @@
 #define LOG_TAG "bt_hci"
 
 #include "hci_layer.h"
+#include <fcntl.h>
+#include <sys/ioctl.h>
 
 #include <base/bind.h>
 #include <base/logging.h>
@@ -375,6 +377,16 @@ static void event_finish_startup(UNUSED_ATTR void* context) {
   startup_future = NULL;
 }
 
+static void hw_reset(bool reset) {
+  unsigned buf[8] = { 8 * 4, 0, 0x38041, 8, 8, 128, 0, 0};
+  buf[6] = reset ? 0 : 1;
+  int fd = open("/dev/vcio", 0);
+  if (fd >= 0) {
+    ioctl(fd, _IOWR(100, 0, char *), buf);
+    close(fd);
+  }
+}
+
 static void startup_timer_expired(UNUSED_ATTR void* context) {
   LOG_ERROR(LOG_TAG, "%s", __func__);
 
@@ -385,6 +397,9 @@ static void startup_timer_expired(UNUSED_ATTR void* context) {
     LOG_ERROR(LOG_TAG, "%s: waiting for abort_timer", __func__);
     return;
   }
+  hw_reset(true);
+  sleep(2);
+  hw_reset(false);
 
   abort();
 }
